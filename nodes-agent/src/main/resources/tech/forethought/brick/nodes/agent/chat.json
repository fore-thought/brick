{
  "version": 2,
  "name": "chat",
  "inputs": [{ "node": "input", "key": "text" },
             { "node": "input", "key": "history" }],
  "outputs": [{ "node": "out", "key": "output" }],
  "nodes": [
    { "id": "config", "type": "config-loader", "config": { "path": "config/llm.properties" } },
    { "id": "input", "type": "input" },
    { "id": "preprocess", "type": "context-preprocess" },
    { "id": "convert", "type": "convert-out" },
    { "id": "call", "type": "llm-call" },
    { "id": "convert-back", "type": "convert-in" },
    { "id": "has-tools", "type": "if" },
    { "id": "exec", "type": "tool-exec" },
    { "id": "out", "type": "output" }
  ],
  "edges": [
    { "from": { "node": "config", "key": "llm" },
      "to":   { "node": "convert", "key": "llm" } },
    { "from": { "node": "input", "key": "messages" },
      "to":   { "node": "preprocess", "key": "messages" } },
    { "from": { "node": "preprocess", "key": "messages" },
      "to":   { "node": "convert", "key": "messages" } },
    { "from": { "node": "preprocess", "key": "tools" },
      "to":   { "node": "convert", "key": "tools" } },
    { "from": { "node": "convert", "key": "request" },
      "to":   { "node": "call", "key": "request" } },
    { "from": { "node": "call", "key": "responses" },
      "to":   { "node": "convert-back", "key": "responses" } },
    { "from": { "node": "preprocess", "key": "messages" },
      "to":   { "node": "convert-back", "key": "messages" } },
    { "from": { "node": "exec", "key": "messages" },
      "to":   { "node": "convert-back", "key": "messages" } },
    { "from": { "node": "convert-back", "key": "hasTools" },
      "to":   { "node": "has-tools", "key": "control" } },
    { "from": { "node": "convert-back", "key": "messages" },
      "to":   { "node": "has-tools", "key": "value" } },
    { "from": { "node": "has-tools", "key": "true" },
      "to":   { "node": "exec", "key": "messages" } },
    { "from": { "node": "has-tools", "key": "false" },
      "to":   { "node": "out", "key": "messages" } },
    { "from": { "node": "exec", "key": "messages" },
      "to":   { "node": "convert", "key": "messages" } }
  ]
}
